%%


BS_001 = Bootstrap_GC_TimeResolved(path2sub, 'CLASE001', ...
    'winLen',250, 'step',25, 'tZero',501, 'baseline',[1 375], ...
    'order',10, 'nBoot',100, 'contrast',{'CHOICE','OUTCOME'}, ...
    'epochOpts',{'winSamples',1500});

Plot_GC_Bootstrap(BS_001);                      % contrast with CI band
Plot_GC_Bootstrap(BS_001, 'view','both');       % change on top, contrast below

T_001 = Report_GC_Effects(BS_001);                          % contrast, cluster-corrected
% T_001 = Report_GC_Effects(BS_001, 'what','both');           % + per-event change
% T_001 = Report_GC_Effects(BS_001, 'csv','CLASE001_effects.csv');

cd('Y:\LossAversion\LH_Data\GC_ConnResults')

T_001_TAB = struct2table(T_001);
T_001_TAB.Subject = repmat({BS_001.subject},height(T_001_TAB),1);
T_001_TAB = movevars(T_001_TAB, 'Subject', 'Before', 1);

save("GCC_CLASE001.mat","T_001","BS_001","T_001_TAB");

